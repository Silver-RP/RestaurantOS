# Google OAuth
GG_CLIENT_ID=your-google-client-id
GG_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
grant_type=authorization_code

# MongoDB
MONGO_URI=mongodb+srv://username:password@cluster-url/dbname

# Twilio
TWILIO_ACCOUNT_SID=your-twilio-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# JWT or token
ACCESS_TOKEN=your-access-token
REFRESH_TOKEN=your-refresh-token

# URLs
CLIENT_BASE_URL=http://localhost:5173
SERVER_BASE_URL=http://localhost:4000

# MoMo
MOMO_PARTNER_CODE=your-partner-code
MOMO_ACCESS_KEY=your-access-key
MOMO_SECRET_KEY=your-secret-key
MOMO_RETURN_URL=http://localhost:4000/api/payment/momo-return

# VNPay
VNP_TMNCODE=your-tmn-code
VNP_HASH_SECRET=your-hash-secret
VNP_RETURN_URL=http://localhost:4000/api/payment/vnpay-return
VNP_API_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_API_CREATE_URL=https://sandbox.vnpayment.vn/merchant_webapi/merchant.html

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Mail
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloud-api-key
CLOUDINARY_API_SECRET=your-cloud-api-secret
